[Unit]
Description=L&D Tracker Webhook Server
After=network.target

[Service]
Type=simple
User=julia
WorkingDirectory=/opt/ld_bot
EnvironmentFile=/opt/ld_bot/config.env
ExecStart=/opt/ld_bot/venv/bin/uvicorn webhook_server:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
